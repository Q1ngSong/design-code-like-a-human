#!/usr/bin/env bash
# 会话开始时，若当前项目启用了本规范就打一段提示；否则静默退出。
#
# hooks 是全局触发的：没有这道守卫，每个无关项目的每次会话都会被打扰。
# .comment-standard.json 的存在与否就是开关，与命令用的是同一个判据。
set -euo pipefail

# 从脚本自身位置推出插件根。逐级解析软链——插件被软链安装时，
# BASH_SOURCE 指向软链自身，直接取 dirname 会算到错误的位置。
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  [[ $src != /* ]] && src="$dir/$src"
done
plugin_root="$(cd -P "$(dirname "$src")/.." && pwd)"

root="$PWD"
while [ "$root" != "/" ]; do
  if [ -f "$root/.comment-standard.json" ]; then
    cat <<MSG
本项目启用了注释标准（检测到 $root/.comment-standard.json）。

写代码前走一遍 writing-minimal-code 的四道决策；docstring 的格式见
writing-python-comments。功能跑通后用 auditing-code-comments 审计。

审计命令（技能里写的是相对技能目录的 ../../scripts/refresh.py，这是绝对路径）：

    python3 "$plugin_root/scripts/refresh.py" "$root"

不要单独运行 codegraph sync —— 它会清空 docstring 回填结果。
索引不用手工建，第一次跑上面这条命令时会自动建好。
MSG
    if [ -f "$root/PROJECT.md" ]; then
      echo
      echo "先读 $root/PROJECT.md —— 这个项目研究什么、主体代码在哪、有哪些规矩和边界。"
      echo "它不写状态：当前结论看实验记录目录的 README，每次尝试看该组 CSV。"
    fi
    s="$root/.codegraph/unattended"
    if [ -f "$s" ]; then
      if [ -n "$(find "$s" -mmin -1440 2>/dev/null)" ]; then
        echo
        echo "无人值守中：$(date -r "$s" '+%m-%d %H:%M') 起，分支 $(head -c 60 "$s" | tr -d '\n')。"
        echo "继续跑：分支上的事（开分支、开几组、试什么、分支间合并、回退、删除）都自己定；不问、不拦，每一步以工具调用收尾，不要交出 turn；审计发现不自动修（实验代码照改）。用户叫停、约定预算用完、或用户给的固定清单跑完时才停止新增尝试，清除标记、补齐记录并收尾到合并前一步；改主分支的事等人回来看过结果再做。"
        echo "标记不证明进程仍在运行，也不授予改主分支或推主分支的权限。恢复时检查进程、CSV 和 Git 状态；结束时清除标记并重新运行上面的审计命令。"
      else
        echo
        echo "注意：$s 已超过 24 小时，视为过期忽略。先核对现有授权和任务状态，仍需继续时再更新标记（touch 它）；已结束则清除。"
      fi
    fi
    exit 0
  fi
  root="$(dirname "$root")"
done
exit 0
